# Copy this file to `.env` and edit values for your environment.

# 遠隔側の ROS_DOMAIN_ID は 0 固定で、ここでは設定できない。scripts/run_zenoh.bash が
# 0 に固定しているため、変えるとブリッジと manager が別 domain に割れて何も届かなくなる。
# 車両側の domain とは無関係で、車両IDで区別する。

# mTLS 素材の置き場所（tls/ の親）。この値は scripts/run_zenoh.bash と
# connect_zenoh.bash が読む。既定はリポジトリルートで、<repo>/tls/ を見る
# （.gitignore 済み）。通常は書かなくてよい。
# TLS_ROOT=/path/to/parent-of-tls

# Host identity. RViz コンテナのユーザーに使う。make が id -u / id -g で自動的に
# 埋めるので、通常は書かなくてよい。
# HOST_UID=1000
# HOST_GID=1000

# レース開始・終了通知の MQTT。telemetry_uploader と同じブローカを使う。
# 認証情報はリポジトリに置かない。別途配布されたものをここに書く。
# MQTT_HOST が空だと通知を送らない（manager は起動する）。
MQTT_HOST=mqtt.dev.aichallenge-board.jsae.or.jp
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ランチャGUI (scripts/gui_tools.py) の車両チェックボックスの既定選択。
# 統括SD (フリート監督) PC は予備以外の全車を書く。例: REMOTE_VEHICLES="A2 A3 A6 A7"
# 単車を扱うPCなどでは書かなくてよい。未設定・空なら何も選ばれない
# （make remote が VEHICLES の既定値を持たないのと同じ理由）。
# REMOTE_VEHICLES=
