<?xml version="1.0" encoding="UTF-8"?>
<!--
  遠隔監視 RViz 用の最小 launch。

  本体リポジトリの aichallenge_system_launch/launch/mode/remote.launch.xml から
  colcon build 成果物への依存を外したもの。違いは3点:
    - global_parameter_loader を使わない（vehicle_info は本リポジトリの xacro が
      load_yaml で直接読む。もともと xacro 内で参照されていない）
    - tier4_vehicle_launch を経由せず racing_kart_description の xacro を直接使う
      （センサ取り付け位置は遠隔監視に不要なので sensor_kit を引かない）
    - 地図と rviz 設定は $(find-pkg-share ...) ではなく引数の実パスで渡す
-->
<launch>
  <arg name="remote_dir" default="/rviz"/>
  <arg name="map_path" default="$(var remote_dir)/map"/>
  <arg name="lanelet2_map_file" default="lanelet2_map.osm"/>
  <arg name="map_param" default="$(var remote_dir)/config/lanelet2_map_loader.param.yaml"/>
  <arg name="model_file" default="$(find-pkg-share racing_kart_description)/urdf/vehicle.xacro"/>

  <!-- 車体モデル: base_link に kart.dae を貼るだけ -->
  <node name="robot_state_publisher" pkg="robot_state_publisher" exec="robot_state_publisher">
    <param name="robot_description" value="$(command 'xacro $(var model_file)' 'warn')"/>
  </node>

  <!-- 地図と map->viewer TF。ノードはすべて /autoware/install 側にある -->
  <group>
    <push-ros-namespace namespace="map"/>
    <node_container pkg="rclcpp_components" exec="component_container" name="map_container" namespace="">
      <composable_node pkg="map_loader" plugin="Lanelet2MapLoaderNode" name="lanelet2_map_loader" namespace="">
        <remap from="output/lanelet2_map" to="vector_map"/>
        <param name="lanelet2_map_path" value="$(var map_path)/$(var lanelet2_map_file)"/>
        <param from="$(var map_param)"/>
        <extra_arg name="use_intra_process_comms" value="false"/>
      </composable_node>
      <composable_node pkg="map_loader" plugin="Lanelet2MapVisualizationNode" name="lanelet2_map_visualization" namespace="">
        <remap from="input/lanelet2_map" to="vector_map"/>
        <remap from="output/lanelet2_map_marker" to="vector_map_marker"/>
        <param name="lanelet2_map_path" value="$(var map_path)/$(var lanelet2_map_file)"/>
        <param from="$(var map_param)"/>
        <extra_arg name="use_intra_process_comms" value="false"/>
      </composable_node>
      <composable_node pkg="map_tf_generator" plugin="VectorMapTFGeneratorNode" name="vector_map_tf_generator" namespace="">
        <param name="map_frame" value="map"/>
        <param name="viewer_frame" value="viewer"/>
        <extra_arg name="use_intra_process_comms" value="false"/>
      </composable_node>
    </node_container>
  </group>
</launch>
